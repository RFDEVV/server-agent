# ──────────────────────────────────────────────────────────────────────────────
# RFMonitor Server Agent — .env
# Copy ke .env lalu isi dengan nilai asli kamu.
# ──────────────────────────────────────────────────────────────────────────────

# Port agen (taruh di belakang Cloudflare Tunnel / Nginx untuk HTTPS+WSS)
PORT=4200

# API Key panjang dan acak — dikirim sekali saat login, lalu app pakai JWT
API_KEY=ganti-ini-dengan-string-panjang-acak

# JWT secret — berbeda dari API_KEY
JWT_SECRET=ganti-ini-juga-string-acak-lain

# ── PM2 ───────────────────────────────────────────────────────────────────────
# Nama app PM2 yang boleh di-start/stop/restart (pisahkan dengan koma).
# Listing GET selalu tampil semua, tapi ACTION dikunci ke list ini.
ALLOWED_PM2_APPS=rfproject-platform,rfproject-bot

# ── Docker ────────────────────────────────────────────────────────────────────
# "*" = izinkan semua container. Atau: "nginx,postgres,immich_server"
ALLOWED_DOCKER_CONTAINERS=*

# ── systemd ───────────────────────────────────────────────────────────────────
# Kosong = systemd tidak aktif. Tambahkan nama unit yang ingin dikontrol.
# Contoh: ALLOWED_SYSTEMD_SERVICES=nginx.service,docker.service
ALLOWED_SYSTEMD_SERVICES=

# ── Power control ─────────────────────────────────────────────────────────────
ALLOW_POWER_CONTROL=true

# ── Listrik & Internet ────────────────────────────────────────────────────────
# Tarif PLN per kWh (Rp) — default tarif R-1 900VA
POWER_IDLE_WATT=30
POWER_MAX_EXTRA_WATT=90
PLN_RATE_PER_KWH=1445
MONTHLY_INTERNET_COST=0

# ── Command Presets ───────────────────────────────────────────────────────────
# Format: "Nama Preset::perintah shell;;Preset Lain::perintah lain"
# Hanya nama preset yang dikirim dari app — perintah tidak pernah keluar server.
# COMMAND_PRESETS=Flush PM2 logs::pm2 flush;;Disk usage::df -h;;Docker prune::docker system prune -f
COMMAND_PRESETS=

# ── CORS ──────────────────────────────────────────────────────────────────────
# "*" = izinkan semua origin. Untuk produksi: "https://app.rfdevv.com"
CORS_ORIGIN=*

# ── Power meter eksternal (OPSIONAL) — untuk server tanpa RAPL (ARM/STB, AMD lama)
# Colokan pintar Shelly/Tasmota = pengukuran listrik NYATA seluruh perangkat.
# POWER_METER_URL=http://192.168.1.50/rpc/Switch.GetStatus?id=0
# POWER_METER_TYPE=shelly        # shelly | shelly1 | tasmota | json
# POWER_METER_JSON_PATH=apower   # hanya untuk type=json (path bertitik)
